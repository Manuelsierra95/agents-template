{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_URL",
    "API_PORT",
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "AUTH_SECRET",
    "AUTH_BASE_URL",
    "AUTH_TRUSTED_ORIGINS",
    "REDIS_URL",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_URL",
        "API_PORT",
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_BASE_URL",
        "AUTH_TRUSTED_ORIGINS",
        "REDIS_URL",
        "NEXT_PUBLIC_API_URL"
      ]
    }
  }
}
