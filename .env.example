# agents-template — local development environment template.
# Copy this file to `.env` (gitignored) and adjust values for your setup.
# All values shown below are the ones baked into
# `packages/infra/docker/compose.yml` as defaults, so a fresh checkout
# works without any edits.

# ─── Postgres ────────────────────────────────────────────────────────────────
# Username used by the postgres container and expected by the app.
POSTGRES_USER=agents

# Password for the postgres user. Override this in any non-local environment.
POSTGRES_PASSWORD=agents

# Database name created on first boot.
POSTGRES_DB=agents

# Host port mapped to the postgres container's internal 5432.
# Change this if 5432 is already in use on the host.
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────────────────
# Host port mapped to the redis container's internal 6379.
# Change this if 6379 is already in use on the host.
REDIS_PORT=6379

# ─── Postgres connection string (used by @workspace/db + apps/api) ──────────
# Matches the compose defaults. Format: postgres://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgresql://agents:agents@127.0.0.1:5432/agents

# ─── Postgres connection string used by the test suite ──────────────────────
# Points at the docker-compose dev DB. Override per environment as needed.
DATABASE_URL_TEST=postgresql://agents:agents@127.0.0.1:5432/agents_test

# ─── Redis connection string (used by apps/api for SSE fan-out) ────────────
# Optional — the API falls back to an in-process event bus when unset.
REDIS_URL=redis://127.0.0.1:6379

# ─── Better Auth ────────────────────────────────────────────────────────────
# Dev-only secret. NEVER use this value in production — rotate it.
# Minimum length is 32 characters (enforced by @workspace/auth).
AUTH_SECRET=dev-secret-do-not-use-in-production-aaaa

# The URL the Better Auth HTTP handler responds on. In dev this is the API.
AUTH_BASE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call Better Auth endpoints.
# In dev this is the web app.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── apps/web → apps/api ────────────────────────────────────────────────────
# Public base URL (browser) and server-side base URL (Server Components).
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# API listens on this port. Defaults to 3000 if unset.
API_PORT=4000
