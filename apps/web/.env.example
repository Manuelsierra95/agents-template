# apps/web — environment variables
#
# Next.js loads `.env.local` automatically in dev. Variables prefixed with
# `NEXT_PUBLIC_` are exposed to the browser bundle at build time — never
# put server-side secrets here.

# Public base URL the browser uses to reach apps/api. In dev this routes
# through the Next.js rewrite defined in `next.config.ts`, so the
# browser stays same-origin and `SameSite=Lax` session cookies are sent.
NEXT_PUBLIC_API_URL=http://localhost:4000
