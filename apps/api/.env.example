# apps/api — environment variables
#
# Copy to `.env` and fill in. Never commit `.env`.

# ─── Server ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated list of origins the API allows CORS requests from.
# "*" permits everything (development only — production should be explicit).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# ─── Postgres (apps/api + packages/db) ──────────────────────────────────────
# Matches the defaults baked into packages/infra/docker/compose.yml
# (POSTGRES_USER=agents, POSTGRES_PASSWORD=agents, DB=agents, port 5432).
# Bring the container up with `pnpm --filter @workspace/infra db:up`.
DATABASE_URL=postgresql://agents:agents@127.0.0.1:5432/agents
DATABASE_URL_TEST=postgresql://agents:agents@127.0.0.1:5432/agents_test

# ─── Better Auth (apps/api + packages/auth) ────────────────────────────────
# ≥ 32 chars. Generate with `openssl rand -hex 32`.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:4000
# Comma-separated additional origins Better Auth should accept cookies from.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── Realtime bus ────────────────────────────────────────────────────────────
# When unset, the API uses an in-process event bus — fine for single-replica
# and dev. Set this in production to fan events across pods via Redis.
# REDIS_URL=

# ─── Agent runtime (apps/agent) ──────────────────────────────────────────────
# URL where apps/api proxies `/eve/*` requests. Matches the port the Eve
# server is bound to inside apps/agent (EVE_PORT=5000).
AGENT_URL=http://127.0.0.1:5000

# Shared secret between apps/api and apps/agent. Two-sided:
#   - apps/api injects `Authorization: Bearer ${INTERNAL_API_TOKEN}` when
#     proxying `/eve/*` upstream so Eve knows the caller is the trusted
#     API gateway.
#   - apps/agent sends the same header on tool calls that hit
#     `/api/internal/*` so apps/api can validate the request comes from
#     the trusted agent runtime (the `requireInternalToken` middleware).
# MUST match the value in apps/agent/.env. Generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=

# Single tenant scope for the agent's internal API. Apps/agent is
# single-tenant; apps/api injects this id on every `/api/internal/*`
# request so the agent doesn't need to know which tenant it's serving.
# Override per-deployment. The default is a placeholder UUID — replace
# with an existing `organization.id` row in production.
PRIMARY_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
