{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    // Bundler resolution — see packages/contracts/tsconfig.json for the
    // full rationale. Cross-package paths map through `paths`; internal
    // imports stay extensionless.
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*", "./tests/*"],
      "@workspace/contracts": ["../../packages/contracts/src/index.ts"],
      "@workspace/contracts/*": ["../../packages/contracts/src/*"],
      "@workspace/contracts/chat": ["../../packages/contracts/src/chat/index.ts"],
      "@workspace/contracts/calendar": ["../../packages/contracts/src/calendar/schemas.ts"],
      "@workspace/auth/*": ["../../packages/auth/src/*"],
      "@workspace/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}