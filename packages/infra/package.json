{
  "name": "@workspace/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./compose": "./src/compose.ts"
  },
  "scripts": {
    "db:up": "tsx src/commands/up.ts",
    "db:down": "tsx src/commands/down.ts",
    "db:status": "tsx src/commands/status.ts",
    "db:logs": "tsx src/commands/logs.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
