{
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Bundler resolution — see packages/contracts/tsconfig.json for the
    // full rationale.
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/auth/*": ["./src/*"],
      "@workspace/db/*": ["../db/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
